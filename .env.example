# Supabase configuration (REPLACE with your project's values)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only secrets (DO NOT put these in client code)
# The Gemini API key must be kept server-side. Do not use REACT_APP_ for it.
# REACT_APP_GEMINI_API_KEY=
# REACT_APP_BASE44_API_URL=https://your-api.example.com
